{
  "mcpServers": {
    "everything": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-everything"]
    },
    "remote-oauth": {
      "type": "http",
      "url": "https://example.com/mcp"
    },
    "remote-token": {
      "type": "http",
      "enabled": false,
      "url": "http://localhost:3001/mcp",
      "headers": { "Authorization": "Bearer <token>" },
      "oauth": false
    }
  }
}
