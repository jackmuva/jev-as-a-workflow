{
  "name": "jaaw",
  "module": "src/index.tsx",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "bun run --watch src/index.tsx",
    "build": "bun build --compile --outfile jaaw src/index.tsx",
    "build:linux-x64": "bun build --compile --target=bun-linux-x64 --outfile dist/jaaw-linux-x64 src/index.tsx",
    "build:linux-arm64": "bun build --compile --target=bun-linux-arm64 --outfile dist/jaaw-linux-arm64 src/index.tsx",
    "build:linux-x64-musl": "bun build --compile --target=bun-linux-x64-musl --outfile dist/jaaw-linux-x64-musl src/index.tsx",
    "build:linux-arm64-musl": "bun build --compile --target=bun-linux-arm64-musl --outfile dist/jaaw-linux-arm64-musl src/index.tsx",
    "build:darwin-x64": "bun build --compile --target=bun-darwin-x64 --outfile dist/jaaw-darwin-x64 src/index.tsx",
    "build:darwin-arm64": "bun build --compile --target=bun-darwin-arm64 --outfile dist/jaaw-darwin-arm64 src/index.tsx",
    "build:windows-x64": "bun build --compile --target=bun-windows-x64 --outfile dist/jaaw-windows-x64.exe src/index.tsx",
    "build:all": "mkdir -p dist && bun run build:linux-x64 && bun run build:linux-arm64 && bun run build:linux-x64-musl && bun run build:linux-arm64-musl && bun run build:darwin-x64 && bun run build:darwin-arm64 && bun run build:windows-x64",
    "lint": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.1",
    "@opentui/core": "^0.5.12",
    "@opentui/react": "^0.5.12",
    "@types/react": "^19.3.0",
    "ai": "^7.0.116",
    "react": "^19.3.0"
  },
  "engines": {
    "bun": ">=1.3.0"
  }
}
